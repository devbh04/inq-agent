# ==============================================================================
# EXIMPLE "SHANAYA" MARINE FREIGHT VOICE AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LIVEKIT CLOUD / SERVER CREDENTIALS
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=eximple-shanaya

# ------------------------------------------------------------------------------
# 2. SARVAM AI CREDENTIALS & MODEL SETTINGS
# ------------------------------------------------------------------------------
# Get your API key from https://dashboard.sarvam.ai
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_VOLUME_THRESHOLD=-35.0          # Decibel noise gate: filters out background talkers 1-2m away
SARVAM_STT_POSITIVE_SPEECH_THRESHOLD=0.82  # Speech confidence threshold (0.0 to 1.0)
SARVAM_STT_INTERRUPT_MIN_SPEECH_FRAMES=6   # Consecutive frames required before barge-in interruption (192ms)
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=simran_hi_sales
SARVAM_TTS_PACE=1.05
SARVAM_TTS_TEMPERATURE=0.60
SARVAM_DEFAULT_LANGUAGE=hi-IN

# ------------------------------------------------------------------------------
# 3. VOBIZ SIP TRUNK CONFIGURATION (FOR TELEPHONY / PSTN CALLS)
# ------------------------------------------------------------------------------
# Outbound SIP Trunk ID from LiveKit Dashboard (format: ST_xxxxxxxxxxxx)
OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx
VOBIZ_SIP_DOMAIN=sip.vobiz.ai
VOBIZ_USERNAME=your_vobiz_sip_username
VOBIZ_PASSWORD=your_vobiz_sip_password
# E.164 caller ID authorized on your Vobiz trunk (e.g., +918000000000)
VOBIZ_OUTBOUND_NUMBER=+918000000000

# ------------------------------------------------------------------------------
# 4. SUPABASE CREDENTIALS (DATABASE PERSISTENCE)
# ------------------------------------------------------------------------------
# Get your project URL and service role key from https://supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-or-anon-key

# ------------------------------------------------------------------------------
# 5. BACKEND REST API CONFIGURATION
# ------------------------------------------------------------------------------
# URL where the LiveKit agent worker sends async tool calls and cost reports
BACKEND_API_URL=http://localhost:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# 6. FRONTEND NEXT.JS PUBLIC CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ------------------------------------------------------------------------------
# 7. BACKEND CUSTOMER PLATFORM (BCP) INTEGRATION & MULTI-ENVIRONMENT CONFIG
# ------------------------------------------------------------------------------
# Active environment selector: "local" | "staging" | "prod"
BCP_ENV=local

# Sales representative assigned to incoming call inquiries in BCP
BCP_SALES_REP_ID=2

# --- Local Environment (Docker or localhost node-app:3000) ---
BCP_URL_LOCAL=http://localhost:3000
BCP_WEBHOOK_KEY_ID_LOCAL=DEV
BCP_WEBHOOK_SECRET_LOCAL=pGQl/pa9+aqThuSrhDgCDKt+vwL8P8Tqz3M7AwpKytM=
BCP_VOICE_AGENT_KEY_LOCAL=eximple_voice_agent_internal_secret_key_2026

# --- Staging Environment (CloudFront) ---
BCP_URL_STAGING=https://dsfomx6jqcacw.cloudfront.net
BCP_WEBHOOK_KEY_ID_STAGING=STAGING
BCP_WEBHOOK_SECRET_STAGING=your-staging-webhook-secret-here
BCP_VOICE_AGENT_KEY_STAGING=

# --- Production Environment ---
BCP_URL_PROD=https://api.eximple.com
BCP_WEBHOOK_KEY_ID_PROD=PROD
BCP_WEBHOOK_SECRET_PROD=your-prod-webhook-secret-here
BCP_VOICE_AGENT_KEY_PROD=
