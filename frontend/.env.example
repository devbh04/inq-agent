# ==============================================================================
# EXIMPLE VOICE AGENT - FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VERCEL PRODUCTION ENVIRONMENT (Set in Vercel Dashboard -> Settings -> Env)
# ------------------------------------------------------------------------------
# The internal AWS ALB address where Next.js server-side rewrites proxy /api & /health
# (Eliminates browser mixed-content errors and CORS)
INTERNAL_BACKEND_URL=http://bot-voice-alb-581005799.ap-south-1.elb.amazonaws.com

# In Vercel, leave NEXT_PUBLIC_BACKEND_URL empty/unset so client requests use
# relative paths (/api/inquiries, /health) which route through Vercel's proxy.

# ------------------------------------------------------------------------------
# 2. LOCAL DEVELOPMENT ENVIRONMENT (Set in .env.local on your laptop)
# ------------------------------------------------------------------------------
# Direct backend URL for running locally on port 8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. SYSTEM VARIABLES AUTOMATICALLY PROVIDED BY VERCEL (DO NOT MANUALLY ADD)
# ------------------------------------------------------------------------------
# NODE_ENV=production        (Automatically set by Vercel during build & runtime)
# VERCEL=1                   (Automatically set by Vercel)
# VERCEL_URL                 (Automatically set to inq-agent.vercel.app)
